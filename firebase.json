{
  "hosting": {
    "target": "yqecea-portfolio",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "GEMINI.md",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "index.backup.html",
      "package.json",
      "package-lock.json",
      "CLAUDE.md",
      "LICENSE",
      "CHANGELOG.md",
      "HANDOFF.md",
      "artifacts/**",
      "plans/**",
      "scripts/**",
      "audit-*.png",
      "logo.png",
      "shot1.png",
      "shot2.png",
      "shot3.png",
      "shot4.png"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31556926; includeSubDomains; preload"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://d3e54v103j8qbb.cloudfront.net https://uploads-ssl.webflow.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://uploads-ssl.webflow.com; img-src 'self' data: blob: https:; media-src 'self' https://yqecea-portfolio.web.app; font-src 'self' data: https://fonts.gstatic.com https://uploads-ssl.webflow.com; connect-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://uploads-ssl.webflow.com https://d3e54v103j8qbb.cloudfront.net; frame-ancestors 'none'; form-action 'self'; base-uri 'self'"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/favicon.ico",
        "destination": "/favicon.svg",
        "type": 301
      },
      {
        "source": "/pages/credits.html",
        "destination": "/pages/work.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/about",
        "destination": "/pages/about.html"
      },
      {
        "source": "/work",
        "destination": "/pages/work.html"
      },
      {
        "source": "/contact",
        "destination": "/pages/contact.html"
      },
      {
        "source": "/cookie",
        "destination": "/pages/cookie.html"
      }
    ]
  }
}
