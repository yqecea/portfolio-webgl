{
  "name": "portfolio-webgl",
  "version": "1.0.0",
  "private": true,
  "description": "Static WebGL portfolio. Verification baseline only - no build step.",
  "scripts": {
    "lint:html": "html-validate \"index.html\" \"pages/**/*.html\"",
    "check:js": "node --check src/main.js && find src -name '*.js' -exec node --check {} \\;",
    "check:cdn-sri": "node scripts/check-cdn-sri.mjs",
    "check:csp-dead-urls": "node scripts/check-csp-dead-urls.mjs",
    "check:ui-contracts": "node scripts/check-ui-contracts.mjs",
    "verify": "npm run check:js && npm run lint:html && npm run check:cdn-sri && npm run check:csp-dead-urls && npm run check:ui-contracts",
    "lint:links": "linkinator https://yqecea-portfolio.web.app --skip '^(https?://(?!yqecea-portfolio\\.web\\.app|niccolomiranda|chiaraluzzana|aitu-halogens|inko|overprint|ciridae|kazakhstan-unesco|oysana|requiem|vent|zero-to-infinity|aipay-landing))'"
  },
  "devDependencies": {
    "html-validate": "^8.0.0",
    "linkinator": "^6.0.0"
  }
}
